{
  "name": "@southneuhof/wisp-core",
  "version": "0.3.0",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "INTEGRATION.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build && node ../../scripts/package-docs.mjs"
  },
  "dependencies": {
    "capnweb": "0.12.0",
    "hash-wasm": "4.12.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {},
  "devDependencies": {},
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Southneuhof contributors",
  "homepage": "https://github.com/southneuhof/wisp#readme",
  "bugs": {
    "url": "https://github.com/southneuhof/wisp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/southneuhof/wisp.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "description": "Framework-independent core for Wisp, a plug-and-play CloudflareOS integration for your app.",
  "keywords": [
    "wisp",
    "cloudflareos",
    "chat",
    "streaming",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
