{
  "name": "@southneuhof/wisp-react-ui",
  "version": "0.3.0",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "INTEGRATION.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build && node ../../scripts/package-docs.mjs"
  },
  "dependencies": {
    "@southneuhof/wisp-core": "workspace:*",
    "@southneuhof/wisp-react": "workspace:*",
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/core": "0.3.32",
    "@base-ui/react": "1.9.0",
    "marked": "^17.0.1"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "3.4.19",
    "postcss": "^8.5.32"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Southneuhof contributors",
  "homepage": "https://github.com/southneuhof/wisp#readme",
  "bugs": {
    "url": "https://github.com/southneuhof/wisp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/southneuhof/wisp.git",
    "directory": "packages/react-ui"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "description": "React UI for Wisp, a plug-and-play CloudflareOS integration for your app.",
  "keywords": [
    "wisp",
    "cloudflareos",
    "chat",
    "react"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
